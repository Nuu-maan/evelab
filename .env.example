# All optional. With none of these set, EveLab runs as a local single-user tool
# against the filesystem.

# Where projects are stored. Defaults to <repo>/.evelab/workspace
# EVELAB_WORKSPACE=

# Live model discovery instead of the built-in fallback list
# AI_GATEWAY_API_KEY=

# Sign-in and project ownership. All four are needed; with any missing, EveLab
# stays in local mode. Apply the schema with `pnpm --filter @evelab/db db:migrate`.
# The GitHub OAuth app's callback URL is <BETTER_AUTH_URL>/api/auth/callback/github
# DATABASE_URL=postgres://user:password@localhost:5432/evelab
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# BETTER_AUTH_SECRET=    (generate with: openssl rand -base64 32)
# BETTER_AUTH_URL=http://localhost:3000

# Source control, local mode: a personal access token with read and write
# access to repository contents. Read on the server only, never stored.
# GITHUB_TOKEN=

# Source control through a GitHub App instead of a token. Takes precedence over
# GITHUB_TOKEN when all three are set.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

# Point the GitHub client somewhere else, such as GitHub Enterprise or the
# end-to-end suite's mock.
# GITHUB_API_URL=https://api.github.com
